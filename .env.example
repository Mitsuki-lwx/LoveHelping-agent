# ============================================================
# lwx-ai-agent 部署环境变量模板（V1）
# 用法：cp .env.example .env → 填入真实值 → docker compose up -d --build
# ⚠️ .env 不要提交到 git（已在 .gitignore / .dockerignore 排除）
# ============================================================

# ---- 数据库密码（容器首次创建时生效，改后需删卷重建）----
MYSQL_PASSWORD=change-me-mysql-strong
PGVECTOR_PASSWORD=change-me-pg-strong

# ---- LLM 密钥 ----
# 主链（ADR-93：cline.bot 网关；供应商在 app.llm.providers 声明）
CLINE_API_KEY=你的cline-bot-key
# 模型名必须带 cline-pass/ 前缀（订阅内 cost=0；deepseek/ 前缀走按量计费，余额不足即 402）
# CLINE_MODEL=cline-pass/deepseek-v4.1-flash
# 网关地址（不设则用 https://api.cline.bot/api）
# CLINE_BASE_URL=https://api.cline.bot/api

# embedding + 远端 rerank（ADR-45/41：硅基流动）——**必填**，缺了 RAG 检索全废
SF_API_KEY=你的硅基流动key

# 原主链 DeepSeek 官方：ADR-93 起默认停用，仅 VisionChatClient 仍读 OPENAI_*
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# 仅回滚用：dashscope（ADR-51 已停用，TLS 中断）——不要填
# DASHSCOPE_API_KEY=

# ---- 可选：知识库运营目录（ADR-89）----
# 把 .md 语料放这里，不用重新构建即可增/改/删知识库内容；删文件会自动清理残留向量。
# 不设 = 只用随包发布的 classpath:document/*.md。
# RAG_DOCS_DIR=/opt/lovehelping/rag-docs

# ---- 可选能力 ----
# MCP 联网搜索工具（不填则该工具不可用）
# SEARCH_API_KEY=
# MCP 图片搜索工具 Pexels（不填则该工具不可用；⛔ 2026-10-13 前它曾硬编码在源码里，见 ADR-86）
# PEXELS_API_KEY=
# 窄结构化判定 JEV（ADR-36/38，默认关）
# JEV_API_KEY=

# ---- 安全 ----
# JWT 签名密钥：必填，≥32 字符随机串（如 openssl rand -hex 32）；缺失则应用拒绝启动
JWT_SECRET=
# 管理端点访问密钥（请求头 X-Admin-Key，用于 golden-set/rag 调试等）
ADMIN_API_KEY=change-me-admin-key

# ---- 限流（change security-hardening：默认开启）----
# ⚠️ 默认就对每个用户生效（100 次/天 + 突发 8 次）。这是防撞库/刷接口的底线，不要随手关。
# 确需关闭（如压测）：DAILY_QUOTA_ENABLED=false —— 启动日志会 WARN 并打印实际生效值。
# DAILY_QUOTA_ENABLED=true
# 单用户每日对话次数（默认 100；旧默认 5 是收费档假设）
# DAILY_QUOTA=100

# ---- 登录失败节流（change security-hardening：默认开启）----
# 连续 5 次失败后指数退避（30s 起，上限 15min）；同一 IP 20 次失败同样退避。
# 锁定期间即使口令正确也返回 429 —— 这是有意的，避免"正确口令能绕过锁定"。
# LOGIN_THROTTLE_ENABLED=true
# LOGIN_THROTTLE_MAX_ATTEMPTS=5

# ---- 邮件（V33 邮箱绑定 / 找回密码）----
# ⛔ prod profile 下**必须配置**，否则应用拒绝启动（fail fast，避免"发不出去还告诉用户已发送"）。
#    QQ/163 的 MAIL_PASSWORD 是「SMTP 授权码」，不是邮箱登录密码。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_FROM=your@qq.com

# ---- 端口（可选，默认 8088）----
# APP_PORT=8088
