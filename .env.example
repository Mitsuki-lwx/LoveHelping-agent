# ============================================================
# lwx-ai-agent 部署环境变量模板（V1）
# 用法：cp .env.example .env → 填入真实值 → docker compose up -d --build
# ⚠️ .env 不要提交到 git（已在 .gitignore / .dockerignore 排除）
# ============================================================

# ---- 数据库密码（容器首次创建时生效，改后需删卷重建）----
MYSQL_PASSWORD=change-me-mysql-strong
PGVECTOR_PASSWORD=change-me-pg-strong

# ---- LLM 密钥 ----
# 主链路：智谱 BigModel OpenAI 兼容端点（与本地验证组合一致）
OPENAI_API_KEY=你的智谱BigModel_key
# 主模型（可选，默认 glm-4-flash——快且稳；可换 glm-4.7 等）
OPENAI_MODEL=glm-4-flash
# 可选：换其它 OpenAI 兼容端点时覆盖 base-url（默认智谱 BigModel）
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# embedding + 降级备模型（qwen-plus）共用：阿里 DashScope key
DASHSCOPE_API_KEY=你的dashscope_key

# ---- 安全 ----
# JWT 签名密钥：必填，≥32 字符随机串（如 openssl rand -hex 32）；缺失则应用拒绝启动
JWT_SECRET=
# 管理端点访问密钥（请求头 X-Admin-Key，用于 golden-set/rag 调试等）
ADMIN_API_KEY=change-me-admin-key

# ---- 端口（可选，默认 8088）----
# APP_PORT=8088
