  <!-- ── 已登记的结构性缺陷（**不是**"没问题"，是"这轮不动"）────────────
       两条都在 ADR-71 里留了记录与风险，属于**已知未修**，不是已解决。 -->

  <!-- ChatExecutor.SYSTEM_PROMPT：5662 字符的常量，且**在另外 3 个 class 文件里重复出现**。
       ⇒ 真正的风险是**提示词多处副本会漂移**（本仓已被"编译期常量 + 断言判旧文本"坑过一次）。
       修它=把提示词集中化，属行为风险改动，单独一轮做。 -->
  <Match>
    <Class name="cn.lwx.lwxaiagent.infrastructure.orchestration.ChatExecutor"/>
    <Bug pattern="HSC_HUGE_SHARED_STRING_CONSTANT"/>
  </Match>

  <!-- ScopeWording：在实例方法里写 static 字段（发布"当前生效措辞"）。
       这是**刻意的**（ADR-53 的可查询证据就是靠它），但同一类曾因**装配顺序**导致配置被静默忽略
       ⇒ 属于"知道它脆、暂时保留"，已在 ADR-71 登记。 -->
  <Match>
    <Class name="cn.lwx.lwxaiagent.infrastructure.orchestration.ScopeWording"/>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
  </Match>

</FindBugsFilter>
