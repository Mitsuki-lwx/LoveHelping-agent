<!--
  SpotBugs 豁免清单（ADR-71）。

  ⛔ 纪律：**每条豁免都必须写出理由**，且优先**精确到 类+方法+模式**，不要整类/整模式豁免 ——
     整类豁免等于把"以后这个类里**新出现**的同类问题"也一起放行了。
  ⛔ 只豁免**已人工复核**的条目。2026-10-01 首次建立时共 7 条，全部来自当时的 High 清单。

  基线（2026-10-01 首次测量，149 条）：High 10 / Medium 139。
  Medium 的大头是 `EI_EXPOSE_REP2`（95 条）= Spring 依赖注入把 bean 引用存进字段，
  那是**框架常态、不是缺陷** ⇒ 门槛只设在 **High**，不把 Medium 变成噪声监狱。
-->
<FindBugsFilter>

  <!-- ── DE_MIGHT_IGNORE：捕获后不处理 ────────────────────────────────
       这 5 处都是**刻意的**：要么是"指标上报不得带崩对话/检索"这类加固，
       要么是"解析失败用默认值"（默认值在 try 之前已赋好）。代码里都有就地注释。 -->
  <Match>
    <Class name="cn.lwx.lwxaiagent.evolution.SkillRetriever"/>
    <Method name="retrieveAsContext"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>
  <Match>
    <Class name="cn.lwx.lwxaiagent.evolution.SkillRetriever"/>
    <Method name="search"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>
  <Match>
    <Class name="cn.lwx.lwxaiagent.infrastructure.orchestration.graph.GraphObservability"/>
